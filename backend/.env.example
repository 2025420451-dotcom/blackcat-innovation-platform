# deploy.sh 会在首次部署时自动生成 .env 和随机密码。
# 如需手动配置，可复制本文件为 .env 后修改。

COMPOSE_PROJECT_NAME=ruoyi
APP_PORT=80
TZ=Asia/Shanghai

MYSQL_DATABASE=ry-vue
MYSQL_USER=ruoyi
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

REDIS_PASSWORD=replace-with-a-strong-password
TOKEN_SECRET=replace-with-a-long-random-token-secret

JAVA_XMS=256m
JAVA_XMX=512m
RUOYI_LOG_LEVEL=info

# 国内服务器若访问 npmjs 较慢，可改为 https://registry.npmmirror.com
NPM_REGISTRY=https://registry.npmjs.org

